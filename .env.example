# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env

# Only for ai.backend: api (the default claude_cli backend uses your Claude plan; leave blank)
ANTHROPIC_API_KEY=

# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (16 chars, no spaces). Not your normal password.
SMTP_PASSWORD=

# Optional, for the adzuna source - https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
